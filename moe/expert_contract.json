  ],
  "extraction": {
    "order": "named field(s) in 'field' first, in the order listed; then anywhere in the output (CR-5, DR-4: Landscape writes MOVEMENT in L3 and Step 3)",
    "label_match": "'<LABEL>' or an alias, followed by optional text up to 60 chars, then ':' (Promethean 'CONFIDENCE AT LEAST <class>:')",
    "value": "the full source line is kept verbatim (upstream copy, brief); the canonical value is the text before the first ' — ', '. ' or ' | ', except that a parenthesized value is kept whole ('Indeterminate (Incremental | Breakthrough)')",
    "case": "values are compared case-insensitively (Org Adoption wrote '(bounded evaluation)')",
    "missing": "a contracted label not found is shown 'not found in output' and is a soft warning; for a decisive label (Adoption RECOMMENDATION, Org Adoption READINESS VERDICT, Landscape STANCE) it is a hard FAIL",
    "indexed": "a label with 'indexed' is read once per index as '<LABEL> [<index>]:' and reported as the ordered set (Org Adoption DEMAND [D1]…[D8])"
  },
  "uncertainty_display": "each expert's own confidence words, plus a separate status OK | ABSTAINED | FAILED | unavailable; no translated scale and no overall confidence (CR-12, I-33)",
  "action_to_stage": {
    "Adopt": "Routine operation",
    "Bounded experiment": "Bounded evaluation",
    "Proof of concept": "Bounded evaluation",
    "Monitor": "Preparation",
    "Defer": "Preparation",
    "Reject for now": "Preparation",
    "Withheld — more evidence": "Preparation",
    "rule": "for an action that starts work (Adopt, Bounded experiment, Proof of concept) only: if Org Adoption reads Not ready or Undetermined (verdict, when STAGE ASKED matches the mapped stage) or Blocked or Undetermined (its STAGE LADDER entry for the mapped stage), the headline gets 'PREPARE ONLY' and F-10 fires; Partially ready / Conditional / Not assessed are shown without a flag (D-73, D-79). F-11 fires for every start action."
  }
}