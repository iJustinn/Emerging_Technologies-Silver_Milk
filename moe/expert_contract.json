{
  "contract_version": "1.0-design",
  "date": "2026-11-24",
  "note": "Lab 10 interface contract (1.0-design). Keyed on agent + label (I-09, I-27). Values copied from each agent's specialist_instructions.md at its tag on main (28ac2d5). Extraction rules: see 'extraction'.",
  "source_pack": {
    "location": "additional_context",
    "heading": "# Fixed evidence register",
    "card_fields": [
      "S<n> <Publisher>: <Title>",
      "URL",
      "Date",
      "Accessed",
      "Source class",
      "Supports",
      "Limits / forbidden inference"
    ],
    "source_classes": [
      "vendor-claim",
      "adopter-self-report",
      "industry-analyst",
      "independent",
      "standards-regulatory"
    ],
    "pack_bound_general_labels": [
      "team_promethean_classification_agent",
      "team_diffusion_agent",
      "team_adoption_agent",
      "team_organizational_adoption_agent",
      "team_innovation_classification_agent:ENTREPRENEURSHIP"
    ]
  },
  "upstream_block": {
    "location": "additional_context (appended after the evidence register)",
    "heading": "# Upstream expert reads (case-premise; produced by other Silver-Milk team specialists in MoE run <RUN ID>)",
    "line": "- <Agent name> <version>: <LABEL>: <value copied verbatim to end of line>",
    "failed": "- <Agent name>: unavailable in this run (failed check)"
  },
  "run_file_pattern": "moe_<RUNID>__<agent_folder>.json (live runs: only this pattern)",
  "legacy_run_patterns": {
    "use": "replay and AC-C1 baselines only (CR-11)",
    "patterns": [
      "<case>_response_v1.0.json",
      "<case>_response_v1_0.json",
      "<case>_response_v1_1.json",
      "<case>_transfer_response_v1_0.json",
      "team_v1_0__<case>.json",
      "team_v1_1__<case>.json"
    ]
  },
  "experts": [
