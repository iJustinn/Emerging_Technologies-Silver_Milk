          "Moderate",
          "High",
          "n/a"
        ]
      },
      "abstention": [
        "Indeterminate (…)",
        "Withheld — insufficient evidence"
      ],
      "pack_bound": true,
      "check_script": "check_promethean_lab05.py",
      "evidence_policy": "general labels pack-only (G-3 hard check)"
    },
