    {
      "folder": "team_promethean_classification_agent",
      "name": "Silver-Milk Team Promethean Classification Agent",
      "version": "1.0-team",
      "tag": "team_promethean_classification_agent-v1.0-team",
      "wave": 1,
      "receives_upstream": [],
      "aliases": [
        "Promethean Agent",
        "Promethean Classification Agent"
      ],
      "headline": [
        {
          "label": "SIGNIFICANCE CLASS",
          "field": "general_et_finding",
          "values": [
            "Incremental",
            "Breakthrough",
            "Potential Promethean",
            "Indeterminate (Incremental | Breakthrough)",
            "Indeterminate (Breakthrough | Potential Promethean)",
            "Withheld — insufficient evidence"
          ]
        },
        {
          "label": "WEIGHT OF BROAD SIGNIFICANCE ON THIS DECISION",
          "field": "organization_specific_finding",
          "values": [
            "Low",
            "Moderate",
            "High"
          ],
          "routing_rule": "route on WEIGHT, never on SIGNIFICANCE CLASS; Indeterminate weighted as its lower label, Withheld as Low (I-12)",
          "alt_label": "WEIGHT"
        },
        {
          "label": "REVERSIBILITY OF THE DECISION",
          "field": "organization_specific_finding",
          "values": [
            "free text; the irreversibility guard sentence fires F-5"
          ]
        }
      ],
      "confidence": {
        "label": "CONFIDENCE AT LEAST <class>: / CONFIDENCE NOT HIGHER",
        "field": "confidence_and_uncertainty",
        "values": [
